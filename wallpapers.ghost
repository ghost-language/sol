import "ghost:math"
import "lumen:canvas"
import "lumen:color"
import { blit, wallpaperImage, wallpaperNames } from 'assets'

// A wallpaper is either one of the flat backgrounds below - a color, or a color
// with a quiet pattern over it - or a PNG the owner dropped in the `wallpapers`
// folder on Sol's disk. Nothing here is a picture of anything: the desktop is
// furniture, and a busy background is the fastest way to make five pixel text
// unreadable.
//
// Every pattern is drawn out of whole rectangles on a whole-pixel grid, so it
// stays a crisp pattern rather than a moire at any scale the desktop is
// stretched to.

palette = {
  ink: color.rgb(9, 9, 13),
  slate: color.rgb(28, 28, 36),
  violet: color.rgb(26, 21, 44),
  line: color.rgb(38, 38, 50),
  dot: color.rgb(56, 54, 78)
}

function fill(w, h, tint) {
  canvas.setColor(tint)
  canvas.filledRectangle(0, 0, w, h)
}

function drawInk(w, h) {
  fill(w, h, palette.ink)
}

function drawSlate(w, h) {
  fill(w, h, palette.slate)
}

function drawViolet(w, h) {
  fill(w, h, palette.violet)
}

// A dot at every twelfth pixel: enough to tell that the desktop has a surface,
// not enough to compete with anything put on top of it.
function drawDots(w, h) {
  fill(w, h, palette.ink)

  canvas.setColor(palette.dot)

  spacing = 12

  for (y = spacing; y < h; y = y + spacing) {
    for (x = spacing; x < w; x = x + spacing) {
      canvas.filledRectangle(x, y, 1, 1)
    }
  }
}

function drawGrid(w, h) {
  fill(w, h, palette.ink)

  canvas.setColor(palette.line)

  spacing = 16

  for (x = 0; x < w; x = x + spacing) {
    canvas.filledRectangle(x, 0, 1, h)
  }

  for (y = 0; y < h; y = y + spacing) {
    canvas.filledRectangle(0, y, w, 1)
  }
}

function drawChecker(w, h) {
  fill(w, h, palette.ink)

  canvas.setColor(palette.slate)

  size = 16
  columns = math.ceil(w / size)
  rows = math.ceil(h / size)

  for (row = 0; row < rows; row++) {
    for (column = 0; column < columns; column++) {
      if ((row + column) % 2 == 0) {
        canvas.filledRectangle(column * size, row * size, size, size)
      }
    }
  }
}

// Every third row, one pixel tall: a CRT's worth of texture for three lines of
// code.
function drawScanlines(w, h) {
  fill(w, h, palette.violet)

  canvas.setColor(palette.ink)

  for (y = 0; y < h; y = y + 3) {
    canvas.filledRectangle(0, y, w, 1)
  }
}

wallpapers = [
  { id: 'ink', name: 'Ink', draw: drawInk },
  { id: 'slate', name: 'Slate', draw: drawSlate },
  { id: 'violet', name: 'Violet', draw: drawViolet },
  { id: 'dots', name: 'Dots', draw: drawDots },
  { id: 'grid', name: 'Grid', draw: drawGrid },
  { id: 'checker', name: 'Checker', draw: drawChecker },
  { id: 'scanlines', name: 'Scanlines', draw: drawScanlines }
]

// A PNG wallpaper is identified as `image:<filename>`, so one settings list can
// hold both the built-in patterns and whatever is on the disk, and so a
// wallpaper the owner later deletes falls back to a pattern rather than to a
// crash.
imagePrefix = 'image:'

function imageId(name) {
  return imagePrefix + name
}

function isImageId(id) {
  return id.startsWith(imagePrefix)
}

function imageName(id) {
  name = ''

  for (index = imagePrefix.length(); index < id.length(); index++) {
    name = name + id[index]
  }

  return name
}

// drawImage centres a PNG at whole-pixel scale rather than stretching it: a
// wallpaper blown up by 1.37 is exactly the soft, smeared thing Sol is trying
// not to be. Anything smaller than the desktop is scaled up in whole steps and
// laid on the desktop color; anything larger is cropped to the middle.
function drawImage(image, w, h) {
  imageWidth = image.getWidth()
  imageHeight = image.getHeight()

  scale = math.floor(math.min(w / imageWidth, h / imageHeight))

  if (scale < 1) {
    scale = 1
  }

  drawWidth = imageWidth * scale
  drawHeight = imageHeight * scale

  fill(w, h, palette.ink)

  blit(image, math.floor((w - drawWidth) / 2), math.floor((h - drawHeight) / 2), scale)
}

// options is what the settings app lists: the built-in patterns, then a row per
// PNG on Sol's disk. It is rebuilt on request rather than cached, so dropping a
// file into the wallpapers folder and reopening Settings is enough to see it.
function options() {
  list = []

  for (index = 0; index < wallpapers.length(); index++) {
    list.push({ id: wallpapers[index].id, name: wallpapers[index].name })
  }

  names = wallpaperNames()

  for (index = 0; index < names.length(); index++) {
    list.push({ id: imageId(names[index]), name: names[index] })
  }

  return list
}

// find returns something drawable for any id, including one naming a PNG that
// has since been deleted.
function find(id) {
  if (isImageId(id)) {
    image = wallpaperImage(imageName(id))

    if (image != null) {
      return { id: id, name: imageName(id), image: image, draw: null }
    }

    return wallpapers[0]
  }

  for (index = 0; index < wallpapers.length(); index++) {
    if (wallpapers[index].id == id) {
      return wallpapers[index]
    }
  }

  return wallpapers[0]
}

// paint is what the desktop calls: it does not care whether the chosen
// wallpaper turned out to be a pattern or a picture.
function paint(id, w, h) {
  chosen = find(id)

  if (chosen.image != null) {
    drawImage(chosen.image, w, h)

    return null
  }

  painter = chosen.draw

  painter(w, h)
}
