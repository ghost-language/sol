import "ghost:math"
import "lumen:canvas"
import * from 'theme'
import { Button, ToggleButton, ScrollList, row } from 'widgets'
import { options, paint } from 'wallpapers'
import { screensavers } from 'screensavers'

idlePresets = [1, 2, 5, 10, 15]

// Settings is two lists and a preview. The wallpaper list is built from the
// patterns Sol ships plus whatever PNGs are on its disk, so it is rebuilt on
// open rather than at startup - a file dropped into the wallpapers folder while
// Sol is running turns up the next time this window does.

class SettingsApp {
  constructor(context) {
    this.context = context
    this.title = 'Settings'
    this.icon = 'settings'
    this.width = 232
    this.height = 150
    this.minWidth = 200
    this.minHeight = 130
    this.tab = 'wallpaper'

    self = this

    this.tabButtons = [
      new ToggleButton(4, 4, 60, 12, 'Wallpaper', function() { return self.tab == 'wallpaper' }, function() { self.tab = 'wallpaper' }),
      new ToggleButton(66, 4, 68, 12, 'Screensaver', function() { return self.tab == 'screensaver' }, function() { self.tab = 'screensaver' })
    ]

    this.wallpaperList = new ScrollList(4, 20, 106, 96, metrics.rowHeight)
    this.wallpaperList.onSelect = function(item, index) { self.context.settings.setWallpaper(item.value) }

    this.screensaverList = new ScrollList(4, 20, 106, 96, metrics.rowHeight)
    this.screensaverList.onSelect = function(item, index) { self.context.settings.setScreensaver(item.value) }

    this.refreshButton = new Button(4, 120, 48, 12, 'Rescan', function() { self.reloadWallpapers() })
    this.minusButton = new Button(4, 120, 12, 12, '-', function() { self.adjustIdle(-1) })
    this.plusButton = new Button(54, 120, 12, 12, '+', function() { self.adjustIdle(1) })
    this.previewButton = new Button(70, 120, 56, 12, 'Preview', function() { self.context.previewScreensaver() })

    this.reloadWallpapers()
    this.loadScreensavers()
  }

  reloadWallpapers() {
    available = options()
    items = []
    selected = -1

    for (index = 0; index < available.length(); index++) {
      option = available[index]

      items.push(row(option.name, option.id, null))

      if (option.id == this.context.settings.wallpaper) {
        selected = index
      }
    }

    this.wallpaperList.setItems(items)
    this.wallpaperList.selected = selected
  }

  loadScreensavers() {
    items = []
    selected = -1

    for (index = 0; index < screensavers.length(); index++) {
      option = screensavers[index]

      items.push(row(option.name, option.id, null))

      if (option.id == this.context.settings.screensaver) {
        selected = index
      }
    }

    this.screensaverList.setItems(items)
    this.screensaverList.selected = selected
  }

  adjustIdle(direction) {
    settings = this.context.settings
    currentIndex = 0

    for (index = 0; index < idlePresets.length(); index++) {
      if (idlePresets[index] == settings.idleMinutes) {
        currentIndex = index
      }
    }

    nextIndex = math.max(0, math.min(idlePresets.length() - 1, currentIndex + direction))

    settings.setIdleMinutes(idlePresets[nextIndex])
  }

  update(dt, pointer) {
    for (index = 0; index < this.tabButtons.length(); index++) {
      this.tabButtons[index].update(pointer)
    }

    if (this.tab == 'wallpaper') {
      this.wallpaperList.update(pointer, dt)
      this.refreshButton.update(pointer)

      return null
    }

    this.screensaverList.update(pointer, dt)
    this.minusButton.update(pointer)
    this.plusButton.update(pointer)
    this.previewButton.update(pointer)
  }

  draw(w, h, pointer) {
    for (index = 0; index < this.tabButtons.length(); index++) {
      this.tabButtons[index].draw(pointer)
    }

    if (this.tab == 'wallpaper') {
      this.wallpaperList.draw(pointer)
      this.refreshButton.draw(pointer)
      this.drawWallpaperPreview()

      return null
    }

    this.screensaverList.draw(pointer)
    this.drawIdleControls(pointer)
  }

  // The preview is the real wallpaper, drawn small: the picker scales the
  // desktop's own painter into a 112x63 box rather than keeping a second,
  // slightly-wrong idea of what each wallpaper looks like.
  drawWallpaperPreview() {
    x = 116
    y = 20
    previewWidth = 112
    previewHeight = 63

    canvas.push()
    canvas.setScissor(x, y, previewWidth, previewHeight)
    canvas.translate(x, y)

    // The preview asks the wallpaper to paint itself at preview size rather
    // than painting a full desktop and shrinking it: a one pixel dot scaled to
    // a quarter is not a smaller dot, it is nothing at all.
    paint(this.context.settings.wallpaper, previewWidth, previewHeight)

    canvas.pop()
    canvas.clearScissor()

    canvas.setColor(theme.border)
    canvas.rectangle(x, y, previewWidth, previewHeight)

    canvas.setColor(theme.textDim)

    fonts.body.print('Drop PNGs into the', x, y + 71)
    fonts.body.print('wallpapers folder on', x, y + 80)
    fonts.body.print('Sol\'s disk.', x, y + 89)
  }

  drawIdleControls(pointer) {
    canvas.setColor(theme.textDim)

    fonts.body.print('The screensaver', 116, 22)
    fonts.body.print('takes over once', 116, 31)
    fonts.body.print('the desktop has', 116, 40)
    fonts.body.print('been idle this', 116, 49)
    fonts.body.print('long.', 116, 58)

    this.minusButton.draw(pointer)
    this.plusButton.draw(pointer)

    canvas.setColor(theme.text)

    label = `${this.context.settings.idleMinutes} min`

    fonts.body.print(label, 18 + (32 - fonts.body.getWidth(label)) / 2, 123)

    this.previewButton.draw(pointer)
  }
}
