import "ghost:math"
import "lumen:canvas"
import * from 'theme'
import { blit, iconImage } from 'assets'

// About Sol - the simplest possible app, mostly here to prove that a window
// needs nothing but a title, a size, and a draw() to exist.

class About {
  constructor(context) {
    this.title = 'About Sol'
    this.width = 152
    this.height = 122
    this.resizable = false
    this.pulse = 0
  }

  update(dt, pointer) {
    this.pulse = this.pulse + dt
  }

  draw(w, h, pointer) {
    cx = math.floor(w / 2)

    // Sol's own icon at double size, with four ticks around it that breathe
    // rather than spin: a rotating shape this small is just a shape that
    // shimmers.
    reach = 26 + math.floor(math.sin(this.pulse * 2) * 2)

    canvas.setColor(theme.accentDim)
    canvas.filledRectangle(cx - 1, 30 - reach, 2, 5)
    canvas.filledRectangle(cx - 1, 30 + reach - 5, 2, 5)
    canvas.filledRectangle(cx - reach, 28, 5, 2)
    canvas.filledRectangle(cx + reach - 5, 28, 5, 2)

    mark = iconImage('about')

    if (mark != null) {
      blit(mark, cx - 20, 9, 2)
    }

    canvas.setColor(theme.text)

    fonts.heading.printCentered('SOL', cx, 54)

    canvas.setColor(theme.textDim)

    lines = [
      'A fantasy workstation',
      'built with Ghost + Lumen',
      '',
      'ghostlang.org'
    ]

    for (index = 0; index < lines.length(); index++) {
      fonts.body.printCentered(lines[index], cx, 74 + index * 9)
    }
  }
}
