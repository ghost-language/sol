import "ghost:json"
import "lumen:filesystem"
import "lumen:window"

// Sol's system preferences: which wallpaper and screensaver are active, how
// long the machine sits idle before the screensaver takes over, and how the
// desktop occupies the real window it has been given. Saved once, at the
// root of Sol's disk, next to the file manager's own folders rather than
// inside them - it is not a document a user manages.

class Settings {
  constructor() {
    this.wallpaper = 'dots'
    this.screensaver = 'orbit'
    this.idleMinutes = 2
    this.pixelPerfect = true
    this.fullscreen = true

    this.load()
    this.applyDisplay()
  }

  load() {
    content = filesystem.read('settings.json')

    if (content == null) {
      return null
    }

    data = json.decode(content)

    if (data.wallpaper != null) {
      this.wallpaper = data.wallpaper
    }

    if (data.screensaver != null) {
      this.screensaver = data.screensaver
    }

    if (data.idleMinutes != null) {
      this.idleMinutes = data.idleMinutes
    }

    if (data.pixelPerfect != null) {
      this.pixelPerfect = data.pixelPerfect
    }

    if (data.fullscreen != null) {
      this.fullscreen = data.fullscreen
    }
  }

  save() {
    filesystem.write('settings.json', json.encode({
      wallpaper: this.wallpaper,
      screensaver: this.screensaver,
      idleMinutes: this.idleMinutes,
      pixelPerfect: this.pixelPerfect,
      fullscreen: this.fullscreen
    }))
  }

  // applyDisplay pushes the loaded (or default) display preferences onto the
  // real window. Called once at startup, and again by every setter below so
  // a change in the settings app takes hold immediately rather than waiting
  // for the next launch.
  applyDisplay() {
    window.setPixelPerfect(this.pixelPerfect)
    window.setFullscreen(this.fullscreen)
  }

  setWallpaper(id) {
    this.wallpaper = id

    this.save()
  }

  setScreensaver(id) {
    this.screensaver = id

    this.save()
  }

  setIdleMinutes(minutes) {
    this.idleMinutes = minutes

    this.save()
  }

  setPixelPerfect(enabled) {
    this.pixelPerfect = enabled

    window.setPixelPerfect(enabled)
    this.save()
  }

  setFullscreen(enabled) {
    this.fullscreen = enabled

    window.setFullscreen(enabled)
    this.save()
  }
}
