import "ghost:date"
import "ghost:math"
import "lumen:canvas"
import "lumen:mouse"
import * from 'theme'
import { truncate } from 'widgets'
import FileManager from 'apps/filemanager'
import TextEdit from 'apps/textedit'
import SettingsApp from 'apps/settingsapp'
import About from 'apps/about'

// The menu bar runs along the top of the screen, the way Picotron's does: the
// system button on the left, a tab per open window beside it, and the clock in
// the right corner. It is the only chrome that is always on screen, so it stays
// eleven pixels tall and says as little as it can get away with.

itemHeight = 12
menuWidth = 84

// launcher builds one system-menu row. Needed for the same reason
// settingsapp.ghost's wallpaperToggle/screensaverToggle are: a closure made
// directly inside the for-loop below would close over the loop's own shared
// variable rather than a copy of it, so every row would launch whatever app
// the loop landed on last.
function launcher(label, build) {
  return { label: label, action: build }
}

class SystemMenu {
  constructor(context) {
    this.open = false

    this.items = [
      launcher('Files', function() { context.wm.open(new FileManager(context)) }),
      launcher('Text Edit', function() { context.wm.open(new TextEdit(context, null)) }),
      launcher('Settings', function() { context.wm.open(new SettingsApp(context)) }),
      launcher('About Sol', function() { context.wm.open(new About(context)) })
    ]
  }

  toggle() {
    this.open = !this.open
  }

  close() {
    this.open = false
  }

  bounds() {
    return { x: 0, y: metrics.menubarHeight, w: menuWidth, h: this.items.length() * itemHeight + 4 }
  }

  itemAt(px, py) {
    bounds = this.bounds()

    if (!hitTest(px, py, bounds.x, bounds.y, bounds.w, bounds.h)) {
      return -1
    }

    index = math.floor((py - bounds.y - 2) / itemHeight)

    if (index < 0 or index >= this.items.length()) {
      return -1
    }

    return index
  }

  // handlePress reports whether it consumed the click - true both when a
  // menu item ran and when the click was simply outside the open menu, since
  // either way the menu closes and nothing under it should also react.
  handlePress(px, py) {
    if (!this.open) {
      return false
    }

    index = this.itemAt(px, py)

    if (index >= 0) {
      this.items[index].action()
    }

    this.close()

    return true
  }

  draw() {
    if (!this.open) {
      return null
    }

    bounds = this.bounds()

    drawPanel(bounds.x, bounds.y, bounds.w, bounds.h)

    for (index = 0; index < this.items.length(); index++) {
      rowY = bounds.y + 2 + index * itemHeight
      hovered = hitTest(mouse.x, mouse.y, bounds.x + 1, rowY, bounds.w - 2, itemHeight)
      labelColor = theme.text

      if (hovered) {
        canvas.setColor(theme.accent)
        canvas.filledRectangle(bounds.x + 1, rowY, bounds.w - 2, itemHeight)

        labelColor = theme.inverse
      }

      canvas.setColor(labelColor)

      fonts.body.print(this.items[index].label, bounds.x + 7, rowY + 3)
    }
  }
}

class Menubar {
  constructor(context) {
    this.context = context
    this.menu = new SystemMenu(context)
  }

  systemButtonBounds() {
    return { x: 0, y: 0, w: 13, h: metrics.menubarHeight }
  }

  tabBounds(index) {
    x = 15

    for (slot = 0; slot < index; slot++) {
      x = x + this.tabWidth(this.context.wm.windows[slot]) + 2
    }

    return { x: x, y: 1, w: this.tabWidth(this.context.wm.windows[index]), h: metrics.menubarHeight - 2 }
  }

  tabWidth(win) {
    return math.min(74, fonts.body.getWidth(win.app.title) + 8)
  }

  // update drives the system menu and the window tabs, and reports whether
  // this frame's click belongs to the bar - the menu floats above everything
  // else on screen, so it has to be asked before the window manager gets a
  // look at the same click.
  update(dt) {
    pressed = mouse.wasButtonPressed('left')

    if (!pressed) {
      return false
    }

    if (this.menu.handlePress(mouse.x, mouse.y)) {
      return true
    }

    system = this.systemButtonBounds()

    if (hitTest(mouse.x, mouse.y, system.x, system.y, system.w, system.h)) {
      this.menu.toggle()

      return true
    }

    windows = this.context.wm.windows

    for (index = 0; index < windows.length(); index++) {
      bounds = this.tabBounds(index)

      if (hitTest(mouse.x, mouse.y, bounds.x, bounds.y, bounds.w, bounds.h)) {
        this.context.wm.bringToFront(windows[index])

        return true
      }
    }

    if (mouse.y < metrics.menubarHeight) {
      return true
    }

    return false
  }

  draw() {
    canvas.setColor(theme.panelDark)
    canvas.filledRectangle(0, 0, 480, metrics.menubarHeight)

    canvas.setColor(theme.border)
    canvas.filledRectangle(0, metrics.menubarHeight - 1, 480, 1)

    this.drawSystemButton()
    this.drawTabs()
    this.drawClock()
    this.menu.draw()
  }

  // The system button is Sol's mark rather than its name: an aperture, a ring
  // with a solid core, which is the one shape that still reads as a mark when
  // it is seven pixels across.
  drawSystemButton() {
    bounds = this.systemButtonBounds()
    fill = theme.accent

    if (this.menu.open or hitTest(mouse.x, mouse.y, bounds.x, bounds.y, bounds.w, bounds.h)) {
      fill = theme.text
    }

    canvas.setColor(fill)
    canvas.filledRectangle(bounds.x + 3, bounds.y + 2, 7, 7)

    canvas.setColor(theme.panelDark)
    canvas.filledRectangle(bounds.x + 4, bounds.y + 3, 5, 5)

    canvas.setColor(fill)
    canvas.filledRectangle(bounds.x + 5, bounds.y + 4, 3, 3)
  }

  drawTabs() {
    windows = this.context.wm.windows
    top = this.context.wm.focused()

    for (index = 0; index < windows.length(); index++) {
      win = windows[index]
      bounds = this.tabBounds(index)

      fill = theme.panel
      labelColor = theme.textDim

      if (win == top) {
        fill = theme.accent
        labelColor = theme.inverse
      } else if (hitTest(mouse.x, mouse.y, bounds.x, bounds.y, bounds.w, bounds.h)) {
        fill = theme.panelLight
        labelColor = theme.text
      }

      canvas.setColor(fill)
      canvas.filledRectangle(bounds.x, bounds.y, bounds.w, bounds.h)

      canvas.setColor(labelColor)

      label = truncate(fonts.body, win.app.title, bounds.w - 6)

      fonts.body.print(label, bounds.x + 3, bounds.y + 2)
    }
  }

  drawClock() {
    text = date.format(date.now(), 'HH:mm')

    canvas.setColor(theme.text)

    fonts.body.print(text, 480 - fonts.body.getWidth(text) - 4, 3)

    canvas.setColor(theme.signal)
    canvas.filledRectangle(480 - fonts.body.getWidth(text) - 9, 5, 2, 2)
  }
}
