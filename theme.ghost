import "lumen:canvas"
import "lumen:color"
import "lumen:font"

// Sol's whole look in one place: a dusk-toned desktop with a warm sun accent,
// so every window, button, and menu comes from the same handful of colors
// rather than picking its own.

theme = {
  desktop: color.rgb(14, 13, 24),
  panel: color.rgb(30, 28, 48),
  panelLight: color.rgb(41, 39, 64),
  panelDark: color.rgb(20, 19, 34),
  border: color.rgb(70, 66, 104),
  borderLight: color.rgb(94, 89, 138),
  titlebar: color.rgb(36, 33, 58),
  titlebarActive: color.rgb(52, 39, 62),
  text: color.rgb(238, 236, 250),
  textDim: color.rgb(148, 143, 179),
  accent: color.rgb(255, 176, 72),
  accentDim: color.rgb(184, 122, 58),
  ember: color.rgb(255, 108, 74),
  good: color.rgb(123, 216, 143),
  bad: color.rgb(255, 107, 107),
  shadow: color.rgb(0, 0, 0, 0.4),
  scrim: color.rgb(10, 9, 18, 0.55)
}

metrics = {
  titlebarHeight: 10,
  taskbarHeight: 13,
  iconWidth: 40,
  iconHeight: 34,
  rowHeight: 10,
  padding: 3
}

// fonts starts as a shell with its fields filled in by loadFonts() below,
// rather than being reassigned wholesale - assignment in Ghost is scoped to
// the function it happens in, so `fonts = { ... }` inside loadFonts() would
// create a local shadowing the module's own `fonts` instead of changing it.
// Setting each property instead mutates the one every other file already
// imported a reference to.
fonts = { tiny: null, body: null, heading: null }

function loadFonts() {
  fonts.tiny = font.system(6)
  fonts.body = font.system(7)
  fonts.heading = font.system(9)
}

function drawPanel(x, y, w, h) {
  canvas.setColor(theme.shadow)
  canvas.filledRectangle(x + 1, y + 2, w, h)

  canvas.setColor(theme.panel)
  canvas.filledRectangle(x, y, w, h)

  canvas.setColor(theme.border)
  canvas.rectangle(x, y, w, h)
}

function drawInset(x, y, w, h) {
  canvas.setColor(theme.panelDark)
  canvas.filledRectangle(x, y, w, h)

  canvas.setColor(theme.border)
  canvas.rectangle(x, y, w, h)
}

// drawButton draws a small chrome button. `pressed` highlights it with the
// accent color, for a toggle or the currently active choice in a picker.
function drawButton(x, y, w, h, label, hovered, pressed) {
  fill = theme.panelLight

  if (pressed) {
    fill = theme.accentDim
  } else if (hovered) {
    fill = theme.borderLight
  }

  canvas.setColor(fill)
  canvas.filledRectangle(x, y, w, h)

  canvas.setColor(theme.border)
  canvas.rectangle(x, y, w, h)

  if (label != null) {
    canvas.setFont(fonts.body)
    canvas.setColor(theme.text)

    textWidth = fonts.body.getWidth(label)

    canvas.print(label, x + (w - textWidth) / 2, y + (h - fonts.body.getHeight()) / 2)
  }
}

function hitTest(px, py, x, y, w, h) {
  return px >= x and px < x + w and py >= y and py < y + h
}
