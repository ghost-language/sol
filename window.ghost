import "ghost:math"
import "lumen:canvas"
import "lumen:mouse"
import * from 'theme'
import { truncate } from 'widgets'

// A Window is chrome wrapped around an app object. An app only has to
// provide `title`, `width`, `height`, and `draw(w, h, pointer)`; everything
// else - `update(dt, pointer)`, `keypressed(key)`, `textinput(text)`,
// `onClose()` - is called if it is there and skipped if it is not, the same
// way Lumen itself treats a game's callbacks as optional.
//
// `pointer` is the app's local, hit-tested mouse state: {x, y, down,
// pressed, released, wheel, hover}, translated into the app's own 0,0
// content coordinates. Only the focused window's content ever gets a live
// one - every other window is handed a dead pointer (hover: false, nothing
// down), so a click through to a background window focuses it rather than
// also landing on whatever happened to be under the cursor.

class Window {
  constructor(app, x, y) {
    this.app = app
    this.x = x
    this.y = y
    this.w = app.width
    this.h = app.height
    this.minWidth = 90
    this.minHeight = 54

    if (app.minWidth != null) {
      this.minWidth = app.minWidth
    }

    if (app.minHeight != null) {
      this.minHeight = app.minHeight
    }

    this.resizable = true

    if (app.resizable != null) {
      this.resizable = app.resizable
    }

    // Minimised windows keep their place in the stack and their app running -
    // the dock is the only thing that can see them - and a zoomed one keeps the
    // bounds it had before, to go back to.
    this.minimized = false
    this.zoomed = false
    this.restoreBounds = null

    this.pointer = deadPointer()
  }

  contentY() {
    return this.y + metrics.titlebarHeight
  }

  totalHeight() {
    return metrics.titlebarHeight + this.h
  }

  // The three controls sit at the left end of the titlebar, in the order macOS
  // puts them: close, minimise, zoom. The dots are five pixels across and the
  // squares you can hit are seven, because five pixels of target is a lot to
  // ask of a pointer.
  controlBounds(index) {
    return { x: this.x + 4 + index * 8, y: this.y + 3, w: 7, h: 7 }
  }

  controlAt(px, py) {
    for (index = 0; index < 3; index++) {
      bounds = this.controlBounds(index)

      if (hitTest(px, py, bounds.x, bounds.y, bounds.w, bounds.h)) {
        return index
      }
    }

    return -1
  }

  controlsWidth() {
    return 28
  }

  resizeGripBounds() {
    return { x: this.x + this.w - 6, y: this.contentY() + this.h - 6, w: 6, h: 6 }
  }

  // zoom fills the desktop between the menu bar and the dock, and remembers
  // enough to put the window back where it was.
  toggleZoom() {
    if (!this.resizable) {
      return null
    }

    if (this.zoomed) {
      bounds = this.restoreBounds

      this.x = bounds.x
      this.y = bounds.y
      this.w = bounds.w
      this.h = bounds.h
      this.zoomed = false

      return null
    }

    this.restoreBounds = { x: this.x, y: this.y, w: this.w, h: this.h }

    this.x = 0
    this.y = desktopTop()
    this.w = 480
    this.h = desktopBottom() - desktopTop() - metrics.titlebarHeight
    this.zoomed = true
  }
}

function deadPointer() {
  return { x: -1, y: -1, down: false, pressed: false, released: false, wheel: 0, hover: false }
}

class WindowManager {
  constructor() {
    this.windows = []
    this.nextId = 1
    this.dragTarget = null
    this.dragOffsetX = 0
    this.dragOffsetY = 0
    this.resizeTarget = null
    this.pendingClose = null
  }

  open(app, x = null, y = null) {
    if (x == null) {
      x = 56 + (this.windows.length() % 6) * 18
    }

    if (y == null) {
      y = desktopTop() + 8 + (this.windows.length() % 6) * 16
    }

    win = new Window(app, x, y)
    win.id = this.nextId
    this.nextId = this.nextId + 1

    this.windows.push(win)

    return win
  }

  isEmpty() {
    return this.windows.length() == 0
  }

  // The focused window is the topmost one that is actually on screen - a
  // minimised window keeps its place in the stack, but nothing about it is
  // clickable until the dock puts it back.
  focused() {
    for (index = this.windows.length() - 1; index >= 0; index--) {
      if (!this.windows[index].minimized) {
        return this.windows[index]
      }
    }

    return null
  }

  minimize(target) {
    target.minimized = true
  }

  restore(target) {
    target.minimized = false

    this.bringToFront(target)
  }

  bringToFront(target) {
    kept = []

    for (index = 0; index < this.windows.length(); index++) {
      if (this.windows[index] != target) {
        kept.push(this.windows[index])
      }
    }

    kept.push(target)
    this.windows = kept
  }

  close(target) {
    kept = []

    for (index = 0; index < this.windows.length(); index++) {
      if (this.windows[index] != target) {
        kept.push(this.windows[index])
      }
    }

    this.windows = kept

    if (target.app.onClose != null) {
      target.app.onClose()
    }
  }

  windowAt(px, py) {
    for (index = this.windows.length() - 1; index >= 0; index--) {
      win = this.windows[index]

      if (win.minimized) {
        continue
      }

      if (hitTest(px, py, win.x, win.y, win.w, win.totalHeight())) {
        return win
      }
    }

    return null
  }

  // handlePress reacts to a fresh left-click against window chrome - the
  // titlebar, the close button, the resize grip - and reports whether it ate
  // the click. A click it did not eat either landed in some window's content
  // (routed separately, below) or on the desktop underneath everything.
  handlePress(mx, my) {
    target = this.windowAt(mx, my)

    if (target == null) {
      return false
    }

    this.bringToFront(target)

    control = target.controlAt(mx, my)

    if (control == 0) {
      this.pendingClose = target

      return true
    }

    if (control == 1) {
      this.minimize(target)

      return true
    }

    if (control == 2) {
      target.toggleZoom()

      return true
    }

    if (target.resizable) {
      grip = target.resizeGripBounds()

      if (hitTest(mx, my, grip.x, grip.y, grip.w, grip.h)) {
        this.resizeTarget = target

        return true
      }
    }

    if (my < target.contentY()) {
      this.dragTarget = target
      this.dragOffsetX = mx - target.x
      this.dragOffsetY = my - target.y

      return true
    }

    return false
  }

  applyDrag(mx, my) {
    target = this.dragTarget

    minX = -(target.w - 24)
    maxX = 480 - 24
    maxY = desktopBottom() - metrics.titlebarHeight

    target.x = math.max(minX, math.min(maxX, mx - this.dragOffsetX))
    target.y = math.max(desktopTop(), math.min(maxY, my - this.dragOffsetY))
  }

  applyResize(mx, my) {
    target = this.resizeTarget

    maxW = 480 - target.x
    maxH = desktopBottom() - target.contentY()

    target.w = math.max(target.minWidth, math.min(maxW, mx - target.x))
    target.h = math.max(target.minHeight, math.min(maxH, my - target.contentY()))
  }

  // update reports whether this frame's click landed on some window at all,
  // chrome or content - so the desktop underneath knows not to also react to
  // it (an icon behind the window that was just clicked, say).
  update(dt, suppressed = false) {
    mx = mouse.x
    my = mouse.y
    pressed = mouse.wasButtonPressed('left') and !suppressed
    released = mouse.wasButtonReleased('left')
    down = mouse.isButtonDown('left')
    wheel = mouse.wheel

    chromeConsumed = false
    windowClicked = false

    if (pressed) {
      windowClicked = this.windowAt(mx, my) != null
      chromeConsumed = this.handlePress(mx, my)
    }

    if (released) {
      this.dragTarget = null
      this.resizeTarget = null
    }

    if (this.dragTarget != null and down) {
      this.applyDrag(mx, my)
    }

    if (this.resizeTarget != null and down) {
      this.applyResize(mx, my)
    }

    this.updateApps(dt, mx, my, pressed and !chromeConsumed, released, down, wheel)

    if (this.pendingClose != null) {
      this.close(this.pendingClose)
      this.pendingClose = null
    }

    return windowClicked
  }

  updateApps(dt, mx, my, pressed, released, down, wheel) {
    top = this.focused()

    for (index = 0; index < this.windows.length(); index++) {
      win = this.windows[index]
      pointer = deadPointer()

      if (win == top and !win.minimized) {
        localX = mx - win.x
        localY = my - win.contentY()
        inside = localX >= 0 and localX < win.w and localY >= 0 and localY < win.h

        if (inside) {
          pointer = { x: localX, y: localY, down: down, pressed: pressed, released: released, wheel: wheel, hover: true }
        }
      }

      win.pointer = pointer

      if (win.app.update != null) {
        win.app.update(dt, pointer)
      }
    }
  }

  keypressed(key) {
    top = this.focused()

    if (top == null) {
      return null
    }

    if (top.app.keypressed != null) {
      top.app.keypressed(key)
    }
  }

  textinput(text) {
    top = this.focused()

    if (top != null and top.app.textinput != null) {
      top.app.textinput(text)
    }
  }

  draw() {
    top = this.focused()

    for (index = 0; index < this.windows.length(); index++) {
      if (!this.windows[index].minimized) {
        this.drawWindow(this.windows[index], this.windows[index] == top)
      }
    }
  }

  // A window wears its title the way a Mac does: the three controls at the left
  // end of the bar, the title centred, and nothing else. The window's own menu
  // is not here - it belongs to the menu bar at the top of the screen, which
  // shows whichever window is focused.
  drawWindow(win, active) {
    canvas.setLineWidth(1)

    barColor = theme.titlebar
    labelColor = theme.textDim

    if (active) {
      barColor = theme.titlebarActive
      labelColor = theme.inverse
    }

    drawPanel(win.x, win.y, win.w, win.totalHeight())

    // The titlebar is rounded along its top edge and square along the bottom,
    // where the content meets it.
    canvas.setColor(barColor)
    canvas.filledRectangle(win.x + metrics.corner, win.y + 1, win.w - metrics.corner * 2, 1)
    canvas.filledRectangle(win.x + 1, win.y + 2, win.w - 2, metrics.titlebarHeight - 2)

    this.drawControls(win, active)

    canvas.setColor(labelColor)

    label = truncate(fonts.body, win.app.title, win.w - win.controlsWidth() * 2 - 8)

    fonts.body.printCentered(label, win.x + win.w / 2, win.y + 3)

    canvas.push()
    canvas.translate(win.x, win.contentY())
    canvas.setScissor(0, 0, win.w, win.h)

    // The content is filled with its own rounded bottom, so the two corners at
    // the foot of the window show the desktop rather than the panel.
    canvas.setColor(theme.panel)
    canvas.filledRectangle(0, 0, win.w, win.h - metrics.corner)
    canvas.filledRectangle(metrics.corner, win.h - metrics.corner, win.w - metrics.corner * 2, metrics.corner)
    canvas.filledRectangle(1, win.h - metrics.corner, metrics.corner - 1, metrics.corner - 1)
    canvas.filledRectangle(win.w - metrics.corner, win.h - metrics.corner, metrics.corner - 1, metrics.corner - 1)

    win.app.draw(win.w, win.h, win.pointer)

    canvas.clearScissor()
    canvas.pop()

    if (win.resizable) {
      this.drawGrip(win)
    }
  }

  // Three dots: red, amber, green while the window is focused, and all three
  // grey while it is not - which is also how a Mac leaves them until you reach
  // for one. Zoom stays grey on a window that cannot be resized, because on
  // that window it does nothing.
  drawControls(win, active) {
    tints = [theme.close, theme.minimize, theme.zoom]

    for (index = 0; index < 3; index++) {
      bounds = win.controlBounds(index)
      tint = theme.idleControl

      if (active and (index < 2 or win.resizable)) {
        tint = tints[index]
      }

      canvas.setColor(tint)

      filledRoundedRectangle(bounds.x + 1, bounds.y + 1, 5, 5, 1)
    }
  }

  // The resize grip is a corner of loose pixels rather than two hairlines:
  // diagonal lines are the one primitive that cannot land on whole pixels at
  // every scale, and a stipple reads as "drag me" just as well.
  drawGrip(win) {
    bounds = win.resizeGripBounds()

    canvas.setColor(theme.borderLight)

    for (step = 0; step < 3; step++) {
      canvas.filledRectangle(bounds.x + bounds.w - 2 - step * 2, bounds.y + bounds.h - 2, 1, 1)
      canvas.filledRectangle(bounds.x + bounds.w - 2, bounds.y + bounds.h - 2 - step * 2, 1, 1)
    }
  }
}
