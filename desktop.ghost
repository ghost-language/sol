import "ghost:math"
import "lumen:canvas"
import "lumen:mouse"
import "lumen:timer"
import * from 'theme'
import * from 'wallpapers'
import { blit, iconImage } from 'assets'
import FileManager from 'apps/filemanager'
import TextEdit from 'apps/textedit'
import SettingsApp from 'apps/settingsapp'
import About from 'apps/about'

// The desktop is the wallpaper plus a column of icons that launch Sol's
// built-in apps. `context` is the shared handle every app is built with:
// { wm, vfs, settings } - the window manager to open windows in, the virtual
// disk, and the saved preferences.
//
// Every icon is a 20x20 PNG out of assets/icons, which the machine's owner can
// replace by dropping their own into `icons` on Sol's disk. The drawn glyphs
// below are the fallback for an icon whose file has gone missing - a desktop
// with a hole in it is worse than one drawn from primitives.

iconSize = 20

function drawFolderGlyph(x, y) {
  canvas.setColor(theme.accent)
  canvas.filledRectangle(x, y + 3, 8, 2)
  canvas.rectangle(x, y + 5, 20, 13)

  canvas.setColor(theme.accentDim)
  canvas.filledRectangle(x + 1, y + 6, 18, 11)

  canvas.setColor(theme.accent)
  canvas.filledRectangle(x + 3, y + 9, 14, 1)
  canvas.filledRectangle(x + 3, y + 12, 10, 1)
}

function drawDocumentGlyph(x, y) {
  canvas.setColor(theme.panelDark)
  canvas.filledRectangle(x + 3, y + 1, 14, 18)

  canvas.setColor(theme.text)
  canvas.rectangle(x + 3, y + 1, 14, 18)
  canvas.filledRectangle(x + 6, y + 5, 8, 1)
  canvas.filledRectangle(x + 6, y + 8, 8, 1)
  canvas.filledRectangle(x + 6, y + 11, 8, 1)

  canvas.setColor(theme.accent)
  canvas.filledRectangle(x + 6, y + 14, 5, 1)
}

// Settings is a rack of sliders rather than the usual gear: three tracks with
// a handle each says "these are the knobs" without needing curves to survive
// being twenty pixels wide.
function drawSlidersGlyph(x, y) {
  canvas.setColor(theme.borderLight)

  for (index = 0; index < 3; index++) {
    canvas.filledRectangle(x + 2, y + 4 + index * 6, 16, 2)
  }

  canvas.setColor(theme.accent)
  canvas.filledRectangle(x + 12, y + 2, 4, 6)
  canvas.filledRectangle(x + 4, y + 8, 4, 6)
  canvas.filledRectangle(x + 13, y + 14, 4, 6)
}

// The same aperture the menu bar wears, at desktop size: a ring, a gap, and a
// solid core.
function drawMarkGlyph(x, y) {
  canvas.setColor(theme.accent)
  canvas.filledRectangle(x + 1, y + 1, 18, 18)

  canvas.setColor(theme.desktop)
  canvas.filledRectangle(x + 4, y + 4, 12, 12)

  canvas.setColor(theme.accent)
  canvas.filledRectangle(x + 7, y + 7, 6, 6)

  canvas.setColor(theme.desktop)
  canvas.filledRectangle(x + 9, y + 1, 2, 4)
  canvas.filledRectangle(x + 9, y + 15, 2, 4)
  canvas.filledRectangle(x + 1, y + 9, 4, 2)
  canvas.filledRectangle(x + 15, y + 9, 4, 2)
}

class DesktopIcon {
  constructor(x, y, label, name, glyph, action) {
    this.x = x
    this.y = y
    this.label = label
    this.name = name
    this.glyph = glyph
    this.action = action
  }

  // draw prefers the icon's PNG and falls back to its drawn glyph. Both land
  // in the same 20x20 box, so the column lines up either way.
  drawGlyph(x, y) {
    image = iconImage(this.name)

    if (image != null) {
      blit(image, x, y, 1)

      return null
    }

    glyph = this.glyph

    glyph(x, y)
  }

  bounds() {
    return { x: this.x, y: this.y, w: metrics.iconWidth, h: metrics.iconHeight }
  }
}

class Desktop {
  constructor(context) {
    this.context = context
    this.icons = this.buildIcons()
    this.selected = -1
    this.lastClickIndex = -1
    this.lastClickTime = -1000
  }

  buildIcons() {
    context = this.context
    top = desktopTop() + 6

    return [
      new DesktopIcon(7, top, 'Files', 'files', drawFolderGlyph, function() {
        context.wm.open(new FileManager(context))
      }),
      new DesktopIcon(7, top + metrics.iconHeight, 'Text Edit', 'textedit', drawDocumentGlyph, function() {
        context.wm.open(new TextEdit(context, null))
      }),
      new DesktopIcon(7, top + metrics.iconHeight * 2, 'Settings', 'settings', drawSlidersGlyph, function() {
        context.wm.open(new SettingsApp(context))
      }),
      new DesktopIcon(7, top + metrics.iconHeight * 3, 'About Sol', 'about', drawMarkGlyph, function() {
        context.wm.open(new About(context))
      })
    ]
  }

  iconAt(px, py) {
    for (index = 0; index < this.icons.length(); index++) {
      bounds = this.icons[index].bounds()

      if (hitTest(px, py, bounds.x, bounds.y, bounds.w, bounds.h)) {
        return index
      }
    }

    return -1
  }

  // update only runs when nothing else claimed the click - the window
  // manager already ate anything that landed on a window.
  update(dt, claimed) {
    if (claimed) {
      return null
    }

    if (!mouse.wasButtonPressed('left')) {
      return null
    }

    index = this.iconAt(mouse.x, mouse.y)

    if (index < 0) {
      this.selected = -1

      return null
    }

    this.selected = index

    doubled = index == this.lastClickIndex and timer.time - this.lastClickTime < 0.4

    if (doubled) {
      this.lastClickIndex = -1
      this.lastClickTime = -1000

      action = this.icons[index].action

      action()
    } else {
      this.lastClickIndex = index
      this.lastClickTime = timer.time
    }
  }

  draw() {
    paint(this.context.settings.wallpaper, 480, 270)

    for (index = 0; index < this.icons.length(); index++) {
      icon = this.icons[index]

      icon.drawGlyph(icon.x + (metrics.iconWidth - iconSize) / 2, icon.y)

      // The label rides its own plate, the way Picotron's do. A wallpaper is
      // whatever the machine's owner made it, so five pixel text cannot count
      // on any particular thing being behind it.
      chipFill = theme.scrim
      chipText = theme.text

      if (index == this.selected) {
        chipFill = theme.accent
        chipText = theme.inverse
      }

      labelWidth = fonts.body.getWidth(icon.label)

      drawChip(icon.label, icon.x + (metrics.iconWidth - labelWidth) / 2, icon.y + 24, chipFill, chipText)
    }
  }
}
