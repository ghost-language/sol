import "ghost:date"
import "ghost:math"
import "lumen:canvas"
import "lumen:mouse"
import * from 'theme'
import { truncate } from 'widgets'
import FileManager from 'apps/filemanager'
import TextEdit from 'apps/textedit'
import PixelArt from 'apps/pixelart'
import SettingsApp from 'apps/settingsapp'
import About from 'apps/about'

itemHeight = 13

// launcher builds one start-menu row. Needed for the same reason
// settingsapp.ghost's wallpaperToggle/screensaverToggle are: a closure made
// directly inside the for-loop below would close over the loop's own shared
// variable rather than a copy of it, so every row would launch whatever app
// the loop landed on last.
function launcher(label, build) {
  return { label: label, action: build }
}

class StartMenu {
  constructor(context) {
    this.open = false

    this.items = [
      launcher('File Manager', function() { context.wm.open(new FileManager(context)) }),
      launcher('Text Edit', function() { context.wm.open(new TextEdit(context, null)) }),
      launcher('Pixel Art', function() { context.wm.open(new PixelArt(context, null)) }),
      launcher('Settings', function() { context.wm.open(new SettingsApp(context)) }),
      launcher('About Sol', function() { context.wm.open(new About(context)) })
    ]
  }

  toggle() {
    this.open = !this.open
  }

  close() {
    this.open = false
  }

  bounds() {
    height = this.items.length() * itemHeight + 4

    return { x: 2, y: 270 - metrics.taskbarHeight - height, w: 96, h: height }
  }

  itemAt(px, py) {
    bounds = this.bounds()

    if (!hitTest(px, py, bounds.x, bounds.y, bounds.w, bounds.h)) {
      return -1
    }

    index = math.floor((py - bounds.y - 2) / itemHeight)

    if (index < 0 or index >= this.items.length()) {
      return -1
    }

    return index
  }

  // handlePress reports whether it consumed the click - true both when a
  // menu item ran and when the click was simply outside the open menu, since
  // either way the menu closes and nothing under it should also react.
  handlePress(px, py) {
    if (!this.open) {
      return false
    }

    index = this.itemAt(px, py)

    if (index >= 0) {
      this.items[index].action()
    }

    this.close()

    return true
  }

  draw() {
    if (!this.open) {
      return null
    }

    bounds = this.bounds()

    drawPanel(bounds.x, bounds.y, bounds.w, bounds.h)
    canvas.setFont(fonts.body)

    for (index = 0; index < this.items.length(); index++) {
      rowY = bounds.y + 2 + index * itemHeight

      if (hitTest(mouse.x, mouse.y, bounds.x + 2, rowY, bounds.w - 4, itemHeight)) {
        canvas.setColor(theme.accentDim)
        canvas.filledRectangle(bounds.x + 2, rowY, bounds.w - 4, itemHeight)
      }

      canvas.setColor(theme.text)
      canvas.print(this.items[index].label, bounds.x + 6, rowY + 3)
    }
  }
}

class Taskbar {
  constructor(context) {
    this.context = context
    this.menu = new StartMenu(context)
  }

  y() {
    return 270 - metrics.taskbarHeight
  }

  startButtonBounds() {
    return { x: 2, y: this.y() + 2, w: 28, h: metrics.taskbarHeight - 4 }
  }

  taskButtonBounds(index) {
    x = 34

    for (slot = 0; slot < index; slot++) {
      x = x + this.taskButtonWidth(this.context.wm.windows[slot]) + 3
    }

    return { x: x, y: this.y() + 2, w: this.taskButtonWidth(this.context.wm.windows[index]), h: metrics.taskbarHeight - 4 }
  }

  taskButtonWidth(win) {
    return math.min(80, fonts.body.getWidth(win.app.title) + 10)
  }

  // update drives the clock, the start button, and the open-window strip,
  // and reports whether this frame's click belongs to the taskbar - the
  // start menu floats above everything else on screen, so it has to be
  // asked before the window manager gets a look at the same click.
  update(dt) {
    pressed = mouse.wasButtonPressed('left')

    if (!pressed) {
      return false
    }

    if (this.menu.handlePress(mouse.x, mouse.y)) {
      return true
    }

    start = this.startButtonBounds()

    if (hitTest(mouse.x, mouse.y, start.x, start.y, start.w, start.h)) {
      this.menu.toggle()

      return true
    }

    windows = this.context.wm.windows

    for (index = 0; index < windows.length(); index++) {
      bounds = this.taskButtonBounds(index)

      if (hitTest(mouse.x, mouse.y, bounds.x, bounds.y, bounds.w, bounds.h)) {
        this.context.wm.bringToFront(windows[index])

        return true
      }
    }

    if (mouse.y >= this.y()) {
      return true
    }

    return false
  }

  draw() {
    canvas.setColor(theme.panelDark)
    canvas.filledRectangle(0, this.y(), 480, metrics.taskbarHeight)
    canvas.setColor(theme.border)
    canvas.line(0, this.y(), 480, this.y())

    this.drawStartButton()
    this.drawTaskButtons()
    this.drawClock()
    this.menu.draw()
  }

  drawStartButton() {
    bounds = this.startButtonBounds()

    fill = theme.accent

    if (this.menu.open) {
      fill = theme.ember
    }

    canvas.setColor(fill)
    canvas.filledRectangle(bounds.x, bounds.y, bounds.w, bounds.h)

    canvas.setFont(fonts.body)
    canvas.setColor(theme.panelDark)

    label = 'Sol'
    labelWidth = fonts.body.getWidth(label)

    canvas.print(label, bounds.x + (bounds.w - labelWidth) / 2, bounds.y + 2)
  }

  drawTaskButtons() {
    windows = this.context.wm.windows
    top = this.context.wm.focused()

    canvas.setFont(fonts.body)

    for (index = 0; index < windows.length(); index++) {
      win = windows[index]
      bounds = this.taskButtonBounds(index)

      fill = theme.panelLight

      if (win == top) {
        fill = theme.borderLight
      }

      canvas.setColor(fill)
      canvas.filledRectangle(bounds.x, bounds.y, bounds.w, bounds.h)
      canvas.setColor(theme.text)

      label = truncate(fonts.body, win.app.title, bounds.w - 6)

      canvas.print(label, bounds.x + 3, bounds.y + 2)
    }
  }

  drawClock() {
    text = date.format(date.now(), 'HH:mm')
    textWidth = fonts.body.getWidth(text)

    canvas.setFont(fonts.body)
    canvas.setColor(theme.text)
    canvas.print(text, 480 - textWidth - 4, this.y() + 2)
  }
}
